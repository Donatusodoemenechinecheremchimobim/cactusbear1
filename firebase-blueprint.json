{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with optional admin privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Product Item",
      "description": "Custom apparel item inside the store catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "details": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "sku": { "type": "string" },
        "imageUrl": { "type": "string" },
        "mockupType": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Pre-order list for delivery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "items", "totalPrice"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Unique user documents."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products database for the store."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of locked customer order transactions."
    }
  }
}
